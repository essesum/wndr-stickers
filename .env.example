# ---- Telegram ----
# Создаётся в @BotFather: /newbot
TELEGRAM_BOT_TOKEN=
# Telegram ID Кати — владелец стикерпака и админ бота
TELEGRAM_OWNER_ID=

# ---- Доступ ----
# open   — любой участник сообщества (по умолчанию)
# allowlist — только ID из ALLOWED_USER_IDS
ACCESS_MODE=open
ALLOWED_USER_IDS=

# ---- Генерация картинок ----
# Цепочка провайдеров через запятую, слева направо с автоматическим fallback.
# codex          — GPT image по подписке ChatGPT через Codex CLI. Ключ НЕ нужен,
#                  картинки не оплачиваются отдельно. Основной путь.
# openrouter_gpt — GPT image через OpenRouter (нужны кредиты на openrouter.ai)
# openai         — прямой api.openai.com (нужен боевой OPENAI_API_KEY)
# gemini         — Google Gemini (работает на бесплатном ключе)
IMAGE_PROVIDER_CHAIN=codex,openrouter_gpt,gemini
# Модель Codex. gpt-4.1 из старого ~/.codex/config.toml с подпиской НЕ работает.
CODEX_MODEL=gpt-5.5

OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=openai/gpt-5-image

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# ---- Сеть ----
# Пусто по умолчанию: runtime sandbox блокирует loopback/shared local services.
# Если нужен внешний HTTPS proxy, укажи не-localhost URL явно.
HTTPS_PROXY=

# ---- Стиль ----
# Канонический лист-референс, прикладывается к каждой генерации
REFERENCE_SHEET=assets/reference/wndr-reference-sheet.png
# Шрифт для впечатывания кириллицы. Impact — самый узкий и жирный из системных.
# Чтобы поставить свой: положи TTF в assets/fonts/ и укажи путь сюда.
FONT_PATH=/System/Library/Fonts/Supplemental/Impact.ttf
# Стрелка / указатель — каноническая форма WNDR v0.1.
ALLOW_ARROW_SHAPES=true

# ---- Стикерпак ----
# Итоговый пак будет называться <PACK_SLUG>_by_<botusername>
PACK_SLUG=wndr
PACK_TITLE=WNDR Stickers
DEFAULT_EMOJI=🔥
# Владелец набора в Telegram. Отдельно от админа: пак передаётся другому
# человеку правкой этой строки, код не меняется. Пусто = владелец бота.
PACK_OWNER_ID=
# Лимит Telegram на статичный набор; дальше бот заводит продолжение автоматически
PACK_CAPACITY=120

# ---- Апрув: что попадает в общий пак ----
REQUIRE_APPROVAL=true
# Список модераторов через запятую — не один человек. Владелец бота в списке всегда.
MODERATOR_IDS=
# После скольких одобренных стикеров автор добавляет в пак без очереди. 0 — никогда.
AUTO_TRUST_AFTER=3
# Чат, куда падают заявки. Пусто — рассылаем модераторам в личку.
MODERATION_CHAT_ID=

# ---- Память сообщества ----
# Ловим повторы ДО генерации, чтобы пак не заплыл вариациями одной мысли.
# Векторы хранятся в SQLite бота; shared Qdrant/Memory API не используются.
DUPLICATE_CHECK=true
# Замер на живых фразах: перефразировки 0.83-0.93, посторонние 0.40-0.63.
DUPLICATE_THRESHOLD=0.82

# ---- Квоты (режим open) ----
RATE_PER_USER_HOUR=5
RATE_PER_USER_DAY=20
RATE_GLOBAL_DAY=300

# ---- Пути: отдельный runtime, вне Katya AI / Hermes / Vault ----
STATE_DIR=/Users/ekaterinasum/.wndr-stickers/state
OUTPUT_DIR=/Users/ekaterinasum/.wndr-stickers/output
